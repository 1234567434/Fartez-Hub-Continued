-- 5.5 ПРОБА — что реально лежит в игре
--     Кнопка в INFO собирает отчёт: все ремоуты с путями, дерево
--     TurkeyRenders, папки яиц и — если попросить — тест всех форм
--     аргумента на живом ремоуте. Отчёт уходит в консоль, в буфер
--     обмена (если исполнитель умеет) и в поле на экране.
-----------------------------------------------------------------------
local function fmtList(tbl, maxN)
    maxN = maxN or 12
    local out = {}
    for i = 1, math.min(#tbl, maxN) do out[#out + 1] = tostring(tbl[i]) end
    if #tbl > maxN then out[#out + 1] = "+" .. (#tbl - maxN) end
    return table.concat(out, ", ")
end

-- Порядок перебора. #2 ({name}) идёт первой: это подтверждённый
-- контракт сервера яиц, и если он рабочий — остальные формы не шлются
-- вовсе. #1 последней из строковых: голая строка скорее вернёт мусор,
-- чем сломает яйцо.
local SHAPE_ORDER = { 2, 3, 4, 5, 6, 1, 7, 8 }

-- Вызывается и вручную (PROBE), и из autoCalibrate. Победитель — первая
-- форма, на которую сервер ответил правдой (RemoteFunction) или после
-- которой цель исчезла (RemoteEvent). Как только он найден, перебор
-- обрывается: восемь ударов по одному яйцу не нужны.
testShapes = function(service, names, target, L, tag, model)
    local found, e = remote(service, names)
    if not found then
        L[#L + 1] = tag .. ": не найден"
        return nil
    end
    L[#L + 1] = tag .. " = " .. e.path .. "  (" .. (e.fn and "RemoteFunction" or "RemoteEvent") .. ")"
    local winner
    for _, id in ipairs(SHAPE_ORDER) do
        local s
        for _, cand in ipairs(ARG_SHAPES) do
            if cand.id == id then s = cand; break end
        end
        if s then
            local arg = s.build(target, model)
            local ok, ret
            if e.fn then
                ok, ret = pcall(function() return found:InvokeServer(arg) end)
            else
                ok, ret = pcall(function() found:FireServer(arg) end)
            end
            L[#L + 1] = string.format("  #%d %-11s ok=%s ret=%s",
                s.id, s.label, tostring(ok), tostring(ret):sub(1, 48))
            if ok and ret then winner = winner or s end
            -- RemoteEvent ничего не возвращает: единственный признак
            -- успеха — цель исчезла после выстрела.
            if not e.fn and model then
                task.wait(0.2)
                local gone = (model.Parent == nil)
                L[#L + 1] = "      gone=" .. tostring(gone)
                if gone then winner = winner or s end
            else
                task.wait(0.05) -- не спамим сервер восемью вызовами в одном кадре
            end
        end
        if winner then break end
    end
    if winner then
        shapeLock[e.path] = winner.id
        F.ArgShape = winner.id
        L[#L + 1] = "  => форма #" .. winner.id .. " (" .. winner.label .. ") выбрана"
    end
    return winner
end

local function probeReport(withTest)
    local L = {}
    local function line(s) L[#L + 1] = tostring(s) end

    line("=== FARTEZ PROBE v4.4 ===")
    line("place=" .. tostring(game.PlaceId) .. "  job=" .. tostring(game.JobId))
    local exOk, exName = pcall(function()
        return (type(identifyexecutor) == "function") and identifyexecutor() or "?"
    end)
    line("executor=" .. (exOk and tostring(exName) or "?"))

    local pkgs = ReplicatedStorage:FindFirstChild("Packages")
    local knit = pkgs and pkgs:FindFirstChild("Knit")
    line("Knit=" .. (knit and "yes" or "no"))
    if knit then
        local services = knit:FindFirstChild("Services")
        if services then
            local names = {}
            for _, s in ipairs(services:GetChildren()) do names[#names + 1] = s.Name end
            table.sort(names)
            line("Knit.Services: " .. table.concat(names, ", "))
        end
    end

    local list = buildIndex(true)
    line("remotes=" .. #list)
    for i, e in ipairs(list) do
        if i > 80 then line("... +" .. (#list - 80)); break end
        line(string.format("  [%s] %s", e.fn and "RF" or "RE", e.path))
    end

    local tr = workspace:FindFirstChild("TurkeyRenders")
    line("TurkeyRenders=" .. (tr and (tr.ClassName .. " children=" .. #(tr:GetChildren())) or "nil"))
    if tr then
        local names = {}
        for _, c in ipairs(tr:GetChildren()) do
            names[#names + 1] = c.Name .. "(" .. c.ClassName .. ")"
        end
        line("  " .. fmtList(names, 15))
    end
    line(turkeyDump(2))
    for _, fname in ipairs({ "Eggs", "EggRenderModels", "World" }) do
        local f = workspace:FindFirstChild(fname)
        line(fname .. "=" .. (f and (f.ClassName .. " children=" .. #(f:GetChildren())) or "nil"))
    end
    for _, fname in ipairs({ "Eggs", "EggRenderModels" }) do
        local f = workspace:FindFirstChild(fname)
        if f then
            local names = {}
            for _, c in ipairs(f:GetChildren()) do
                names[#names + 1] = c.Name .. "(" .. c.ClassName .. ")"
            end
            line("  " .. fname .. ": " .. fmtList(names, 10))
        end
    end

    local turkeys, eggs, vault = refreshTurkeys(), refreshEggs(), refreshVaultEggs()
    line("targets: turkeys=" .. #turkeys .. "  eggs=" .. #eggs .. "  vault=" .. #vault)
    line("argShape=" .. tostring(F.ArgShape))
    line("calibrations=" .. tostring(S.calib or 0) .. "  last=" .. tostring(S.lastCalib or "—"))
    line(containerDump())

    if withTest then
        local eggT   = eggs[1]
        local vaultT = vault[1]
        local model  = eggT and eggT.obj or nil
        local target = eggT and eggT.name or (turkeys[1] and turkeys[1].name) or nil
        line("")
        line("--- TEST (target=" .. tostring(target) .. ") ---")
        if not target then
            line("нет цели — запусти в игре, не в лобби")
        else
            testShapes("EggSpawnerService", EGG_REMOTES, target, L, "egg", model)
            if vaultT then
                testShapes("EggVaultService", VAULT_REMOTES, vaultT.name, L, "vault", vaultT.obj)
            else
                testShapes("EggVaultService", VAULT_REMOTES, target, L, "vault", model)
            end
        end

        -- Turkey: аргумент — массив id, поэтому общий перебор форм
        -- здесь не годится. Проверяем ровно то, что шлёт фича.
        line("")
        line("--- TURKEY BATCH TEST ---")
        local ids = {}
        for _, t in ipairs(turkeys) do
            if t.id then ids[#ids + 1] = t.id end
            if #ids >= 2 then break end
        end
        if #ids == 0 then
            line("id индеек не найдены — смотри TURKEY DUMP выше")
        else
            local rf = select(2, remote("TurkeyService", TURKEY_HIT_REMOTES))
            if not rf then
                line("RequestHitTurkeys не найден в ReplicatedStorage")
            else
                line("remote=" .. rf.path .. "  (" .. (rf.fn and "RemoteFunction" or "RemoteEvent") .. ")")
                local ok, ret = pcall(function()
                    if rf.fn then return rf.obj:InvokeServer(ids) end
                    return rf.obj:FireServer(ids)
                end)
                line("  args=" .. table.concat(ids, ",") .. "  ok=" .. tostring(ok)
                    .. "  ret=" .. tostring(ret):sub(1, 60))
            end
        end
    end

    line("")
    line("=== END ===")
    return table.concat(L, "\n")
end

local function publishProbe(withTest)
    local report = probeReport(withTest)
    print(report)
    local copied = false
    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, report)
    end
    if type(writefile) == "function" then
        pcall(writefile, "fartez_probe.txt", report)
    end
    return report, copied
end

