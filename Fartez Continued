                for _, d in pairs(PlayerGui:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
                        local t = (d:IsA("TextButton") and d.Text:lower()) or ""
                        if t:find("drop") or d.Name:lower():find("drop") then
                            dropOpen = true; break
                        end
                    end
                end
            end
            if dropOpen then return end

            local rootPart = char.HumanoidRootPart
            local pickedUp = false

            for _, d in pairs(workspace:GetDescendants()) do
                if pickedUp then break end

                if d:IsA("ProximityPrompt") then
                    local txt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
                    local ignored = false
                    for _, a in ipairs(IgnoreActions) do
                        if txt:find(a) then ignored = true; break end
                    end
                    if not ignored and (txt:find("pick") or txt:find("up")) then
                        local part = d:FindFirstAncestorWhichIsA("BasePart")
                        if part and (part.Position - rootPart.Position).Magnitude <= 15 then
                            fireproximityprompt(d)
                            pickedUp = true
                        end
                    end
                end

                if d:IsA("BillboardGui") and not pickedUp then
                    local allText, hasPickup = "", false
                    for _, c in pairs(d:GetDescendants()) do
                        if c:IsA("TextLabel") then
                            local t = c.Text:lower()
                            allText = allText .. " " .. t
                            if t:find("pick") or t:find("up") then hasPickup = true end
                        end
                    end
                    local ignored = false
                    for _, a in ipairs(IgnoreActions) do
                        if allText:find(a) then ignored = true; break end
                    end
                    if hasPickup and not ignored then
                        local adornee = d.Adornee or d:FindFirstAncestorWhichIsA("BasePart")
                        if adornee and (adornee.Position - rootPart.Position).Magnitude <= 15 then
                            for _, c in pairs(d:GetDescendants()) do
                                if (c:IsA("TextButton") or c:IsA("ImageButton")) and getconnections then
                                    for _, conn in pairs(getconnections(c.MouseButton1Click)) do
                                        conn:Fire()
                                        pickedUp = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
