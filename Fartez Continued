-- NEW: AUTO HIT TURKEY -------------------------------------------------
--   TurkeyService.RF.RequestHitTurkeys ждёт МАССИВ id: {"t903","t904"}.
--   Один вызов = одна пачка. Пачка режется по CFG.turkeyBatch, чтобы
--   не улетать в лимит аргументов и не ловить кик за спам.
local turkeyWarnedNoId = false
local bruteCursor = 1
local turkeyCursor = 1

local function turkeyIdsInRange(list, origin, range, ignoreRange)
    local rows, seen = {}, {}
    for _, t in ipairs(list) do
        if t.id and not seen[t.id] then
            local d = (t.part.Position - origin).Magnitude
            if ignoreRange or d <= range then
                seen[t.id] = true
                rows[#rows + 1] = { id = t.id, dist = d, entry = t }
            end
        end
    end
    table.sort(rows, function(a, b) return a.dist < b.dist end)
    return rows
end

-- Отправка массива id в TurkeyService. Возвращает число отправленных id.
local function fireTurkeyBatch(ids)
    if #ids == 0 then return 0 end
    local e = select(2, remote("TurkeyService", TURKEY_HIT_REMOTES))
    if not e or not e.obj or not e.obj.Parent then
        -- запасной путь: тем же массивом в egg-ремоут (некоторые сборки
        -- игры принимают id индеек там же)
        if F.TurkeyHitVault then
            local ee = select(2, remote("EggSpawnerService", EGG_REMOTES))
            if ee and ee.obj and ee.obj.Parent then
                for i = 1, #ids, CFG.turkeyBatch do
                    local chunk = table.move(ids, i, math.min(i + CFG.turkeyBatch - 1, #ids), 1, {})
                    fireArgs(ee, table.pack(chunk))
                end
                return #ids
            end
        end
        return 0
    end

    local sent = 0
    for i = 1, #ids, CFG.turkeyBatch do
        local chunk = table.move(ids, i, math.min(i + CFG.turkeyBatch - 1, #ids), 1, {})
        if fireArgs(e, table.pack(chunk)) then sent += #chunk end
    end
    return sent
end

-- Перебор t1..tN: единственный путь, когда игра не отдаёт id клиенту.
-- За тик уходит одна пачка, курсор двигается по кругу.
local function fireTurkeyBrute()
    local total = math.max(1, math.floor(F.TurkeyBruteMax or 1000))
    local step = math.max(1, math.floor(CFG.turkeyBatch))
    local ids = {}
    for i = 0, step - 1 do
        local n = bruteCursor + i
        while n > total do n -= total end
        ids[#ids + 1] = "t" .. n
    end
    bruteCursor += step
    while bruteCursor > total do bruteCursor -= total end
    return fireTurkeyBatch(ids)
end

-- Ходьба, а не телепорт: MoveTo каждый тик (сам по себе он затухает
-- через 8 с), плюс прыжок, если упёрлись в геометрию и стоим на месте.
local lastJumpAt = 0
local function walkTo(hum, hrp, pos)
    hum:MoveTo(pos)
    local v = hrp.AssemblyLinearVelocity
    local flat = Vector3.new(v.X, 0, v.Z).Magnitude
    local far = (pos - hrp.Position).Magnitude > 6
    if far and flat < 1.2 and os.clock() - lastJumpAt > 1.0 then
        lastJumpAt = os.clock()
        hum.Jump = true
    end
end

local coinTrack = { part = nil, at = 0 }
local moveAt = 0

local function featureTurkey()
    if not F.AutoHitTurkey then return end
    local _, hum, hrp = refreshChar()
    if not hrp then return end

    local list = refreshTurkeys()

    -- 1. УДАР. Летит всегда и независимо от дистанции: сервер её не
    --    проверяет, поэтому бить можно на ходу, пока идём к цели.
    --    Окно по списку, а не жёсткая отсечка: иначе при большом загоне
    --    всегда бьются одни и те же ближние индейки, а дальние — никогда.
    local sent = 0
    if #list > 0 then
        local rows = turkeyIdsInRange(list, hrp.Position, CFG.ranges.turkey, F.TurkeyAll)
        if #rows > 0 then
            local want = math.min(math.max(1, CFG.maxTargets), #rows)
            local ids = {}
            for k = 0, want - 1 do
                local idx = ((turkeyCursor - 1 + k) % #rows) + 1
                ids[#ids + 1] = rows[idx].id
            end
            turkeyCursor = ((turkeyCursor - 1 + #ids) % #rows) + 1
            sent = fireTurkeyBatch(ids)
        end
    end
    if sent == 0 and F.TurkeyBrute and (#list == 0 or S.turkeyIds == 0) then
        sent = fireTurkeyBrute()
    end
    S.turkeySent = sent

    if #list > 0 and S.turkeyIds == 0 and not F.TurkeyBrute and not turkeyWarnedNoId then
        turkeyWarnedNoId = true
        print("[FARTEZ] у моделей Turkey не найден id — открой вкладку TURKEY, жми SCAN, "
            .. "либо включи перебор t1..tN")
    end

    -- 2. ХОДЬБА. Приоритет — монета: индейка умерла, дроп лежит, пока его
    --    не подобрали, к следующей не идём.
    if not F.TurkeyTravel then return end
    local nowMove = os.clock()
    if nowMove - moveAt < 0.1 then return end
    moveAt = nowMove

    if F.TurkeyCollect then
        -- монета, которую несут/собрали, исчезает из воркспейса — считаем
        if coinTrack.part and coinTrack.part.Parent == nil then
            S.coinsTaken += 1
            coinTrack = { part = nil }
        end

        local coin, coinDist = nearestCoin(hrp.Position, CFG.ranges.turkeyDrop)
        if coin then
            if coinTrack.part ~= coin.part then
                coinTrack = {
                    part = coin.part, at = os.clock(),
                    best = coinDist, dist = coinDist, mark = os.clock(),
                }
            else
                if coinDist < coinTrack.best then
                    coinTrack.best = coinDist
                    coinTrack.mark = os.clock()
                end
                -- застряли рядом (8 с без сближения) или вышли из бюджета пути
                local budget = CFG.turkeyCoinWait + (coinTrack.dist or 0) / 10
                local closeStuck = coinDist < 60 and (os.clock() - coinTrack.mark > 8)
                if closeStuck or (os.clock() - coinTrack.at > budget) then
                    coinSkip[coin.part] = os.clock() + 30
                    coinTrack = { part = nil }
                    coin = nil
                end
            end
        end
        if coin then
            if coinDist <= CFG.turkeyCoinStop then
                hum:MoveTo(coin.part.Position)
                firePromptsNear(coin.part, CFG.turkeyCoinStop + 6)
            else
                walkTo(hum, hrp, coin.part.Position)
            end
            return
        end
        coinTrack = { part = nil }
    end

    local near, dist = nearest(list, hrp.Position)
    if not near then
        hum:MoveTo(hrp.Position)
        return
    end
    if dist <= CFG.turkeyApproach then
        hum:MoveTo(hrp.Position) -- подошли, стоим и бьём
    else
        walkTo(hum, hrp, near.part.Position)
    end
end

