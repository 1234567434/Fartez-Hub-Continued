-- Анти-афк нужен только когда что-то реально работает: иначе он просто
-- дёргает мышь в пустоту. Включается сам вместе с любой авто-фичей
-- (в первую очередь с авто-битьём индеек) и выключается переключателем.
local function autoAfkWanted()
    if F.AutoAntiAfk == false then return false end
    return F.AutoHitTurkey or F.AutoBreak or F.AutoHitBigEgg or F.AutoHitHalloween
        or F.AutoBreakBoss or F.AutoKeyVaultZone1 or F.AutoKeyVaultZone2
        or F.AutoKeyVaultZone3 or F.AutoBuyEggs or F.AutoCollect or F.AutoPickUp
        or F.AutoRebirth or F.AutoUpgradeAll or F.AutoUpgradeSpecific
end

local antiAfkArmed = false
local antiAfkAt = 0

local function armAntiAfk()
    if antiAfkArmed then return end
    antiAfkArmed = true
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(LocalPlayer.Idled)) do
                pcall(function() c:Disable() end)
            end
        end
    end)
end

local function featureAntiAfk()
    if not autoAfkWanted() then return end
    armAntiAfk()
    local now = os.clock()
    if now - antiAfkAt < 55 then return end
    antiAfkAt = now
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

