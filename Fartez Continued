-- TURKEY
--   workspace.TurkeyRenders/<Turkey>, внутри — объект Hitbox.
--   Сервер различает индеек по строковому id вида "t904", поэтому
--   модель мало найти — надо вытащить её id. Где именно игра его
--   держит, из исходников не видно, поэтому id ищется по всем
--   разумным местам, от дешёвых к дорогим:
--     1. имя самой модели
--     2. атрибуты модели (Id / ID / id / TurkeyId / Identifier ...)
--     3. атрибуты и имена потомков, значения ValueBase
--     4. имя Hitbox и его атрибуты
--   Если ни один шаг не дал id — вкладка TURKEY покажет SCAN с полным
--   деревом модели, а перебор t1..tN останется рабочим запасным путём.
-----------------------------------------------------------------------
local TURKEY_FOLDERS  = { "TurkeyRenders", "TurkeyRenderModels", "Turkeys", "TurkeyModels" }
local TURKEY_DROP_FOLDERS = { "TurkeyDrops", "TurkeyDrop", "TurkeyCoins", "TurkeyCoinDrops" }
local TURKEY_ID_MATCH = "^[tT]%d+$"
local TURKEY_ID_KEYS  = {
    "Id", "ID", "id", "TurkeyId", "turkeyId", "Identifier",
    "Uid", "uid", "Index", "index", "EggId", "TargetId",
}

local function idFromValue(v)
    if type(v) == "string" then
        if v ~= "" then return v end
        return nil
    end
    if type(v) == "number" then
        return "t" .. tostring(math.floor(v))
    end
    return nil
end

local function attrIdOf(obj)
    if not obj then return nil end
    for _, key in ipairs(TURKEY_ID_KEYS) do
        local ok, v = pcall(obj.GetAttribute, obj, key)
        if ok and v ~= nil then
            local id = idFromValue(v)
            if id then return id end
        end
    end
    return nil
end

-- id модели индейки.
-- Строгий проход ищет всё, что похоже на "t904" (имя модели, имя потомка,
-- значения ValueBase, атрибуты). Свободный проход запоминает первое
-- непустое значение из ValueBase/атрибутов и отдаётся только если
-- строгий проход ничего не нашёл — имя части вроде "Hitbox" сюда не
-- попадает и не может подменить настоящий id.
local function turkeyIdOf(model, hitbox)
    if not model then return nil end
    local loose = nil

    local function strict(v)
        if type(v) == "string" and v:match(TURKEY_ID_MATCH) then return v end
        return nil
    end
    local function keepLoose(v)
        if type(v) == "string" and v ~= "" and not loose then loose = v end
    end
    local function attrPass(node)
        for _, key in ipairs(TURKEY_ID_KEYS) do
            local ok, v = pcall(node.GetAttribute, node, key)
            if ok and v ~= nil then
                local id = idFromValue(v)
                local hit = strict(id)
                if hit then return hit end
                keepLoose(id)
            end
        end
        return nil
    end

    local hit = strict(model.Name)
    if hit then return hit end
    hit = attrPass(model)
    if hit then return hit end

    local okD, kids = pcall(function() return model:GetDescendants() end)
    if okD then
        for _, c in ipairs(kids) do
            if c:IsA("ValueBase") then
                local id = idFromValue(c.Value)
                hit = strict(id)
                if hit then return hit end
                keepLoose(id)
            end
            hit = attrPass(c)
            if hit then return hit end
        end
    end

    if hitbox then
        hit = strict(hitbox.Name)
        if hit then return hit end
        hit = attrPass(hitbox)
        if hit then return hit end
    end

    -- последний шанс: имя модели само может быть идентификатором
    -- ("Turkey_903", "903"). Общие имена вроде "Turkey" не берём —
    -- они одинаковые у всех и серверу ничего не скажут.
    local nm = model.Name
    if not loose and nm ~= "" and not nm:lower():match("^turkey") then
        loose = nm:match("^%d+$") and ("t" .. nm) or nm
    end

    return loose
end

local function turkeyFolders()
    local out = {}
    for _, n in ipairs(TURKEY_FOLDERS) do
        local f = workspace:FindFirstChild(n)
        if f then out[#out + 1] = f end
    end
    return out
end

local function isTurkeyObject(d)
    if not (d:IsA("Model") or d:IsA("BasePart")) then return false end
    local ok, hb = pcall(function() return d:FindFirstChild("Hitbox") end)
    if ok and hb then return true end
    -- модель может называться прямо "t903" — тогда Hitbox ищем глубже
    if d:IsA("Model") and d.Name:match(TURKEY_ID_MATCH) then return true end
    if d:IsA("Model") and d.Name:lower():find("turkey", 1, true) then return true end
    return false
end

local function hitboxOf(d)
    local hb = d:FindFirstChild("Hitbox")
    if hb then return hb end
    if d:IsA("Model") then
        local ok, deep = pcall(function() return d:FindFirstChild("Hitbox", true) end)
        if ok and deep then return deep end
    end
    return nil
end

local turkeyCache = { at = -math.huge, list = {} }
local function refreshTurkeys()
    local now = os.clock()
    if now - turkeyCache.at < 0.25 then return turkeyCache.list end
    local list, seen = {}, {}
    local folders = turkeyFolders()

    local function consider(d)
        if seen[d] or not isTurkeyObject(d) then return end
        seen[d] = true
        local hb = hitboxOf(d)
        local part = (hb and partOf(hb)) or partOf(d)
        if not part then return end
        list[#list + 1] = {
            obj    = d,
            part   = part,
            name   = d.Name,
            hitbox = hb,
            id     = turkeyIdOf(d, hb),
        }
    end

    for _, folder in ipairs(folders) do
        for _, d in ipairs(folder:GetDescendants()) do consider(d) end
    end
    -- контейнера нет или он пуст — смотрим прямых детей workspace
    if #list == 0 then
        for _, d in ipairs(workspace:GetChildren()) do consider(d) end
    end

    turkeyCache.at, turkeyCache.list = now, list
    S.turkeys = #list
    local withId = 0
    for _, t in ipairs(list) do if t.id then withId += 1 end end
    S.turkeyIds = withId
    return list
end

-- Полный дамп индейки: контейнер, модель, id, хитбокс, атрибуты,
-- всё поддерево. Нужен, когда id не нашёлся автоматически.
local function turkeyDump(maxModels)
    maxModels = maxModels or 3
    local L = {}
    local function line(s) L[#L + 1] = tostring(s) end

    line("=== TURKEY DUMP ===")
    local folders = turkeyFolders()
    if #folders == 0 then
        line("контейнеров нет. искал: " .. table.concat(TURKEY_FOLDERS, ", "))
        line("workspace: ")
        for _, c in ipairs(workspace:GetChildren()) do
            if c.Name:lower():find("turkey", 1, true) then
                line("  " .. c.ClassName .. " " .. c.Name)
            end
        end
    end
    for _, f in ipairs(folders) do
        line(f.Name .. " (" .. f.ClassName .. ") children=" .. #f:GetChildren())
    end

    local list = refreshTurkeys()
    line("моделей с хитбоксом: " .. #list .. "   с id: " .. S.turkeyIds)
    if #list == 0 then
        line("пусто — запускай в игре, не в лобби")
        line("=== END ===")
        return table.concat(L, "\n")
    end

    local shown = 0
    for _, t in ipairs(list) do
        if shown >= maxModels then break end
        shown += 1
        line("")
        line("model " .. t.obj:GetFullName())
        line("  id=" .. tostring(t.id))
        line("  hitbox=" .. (t.hitbox and (t.hitbox:GetFullName() .. " (" .. t.hitbox.ClassName .. ")") or "nil"))
        line("  part=" .. t.part:GetFullName())
        local okA, attrs = pcall(function() return t.obj:GetAttributes() end)
        if okA then
            local parts = {}
            for k, v in pairs(attrs) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end
            table.sort(parts)
            line("  attributes: " .. (#parts > 0 and table.concat(parts, ", ") or "нет"))
        end
        local okD, kids = pcall(function() return t.obj:GetDescendants() end)
        if okD then
            for _, c in ipairs(kids) do
                local extra = ""
                if c:IsA("ValueBase") then extra = "  value=" .. tostring(c.Value) end
                local ca = attrIdOf(c)
                if ca then extra = extra .. "  idAttr=" .. ca end
                line("  ." .. c.ClassName .. " " .. c.Name .. extra)
            end
        end
    end

    line("")
    line("=== END ===")
    return table.concat(L, "\n")
end

local promptCache = { at = -math.huge, list = {} }
local function refreshPrompts()
    local now = os.clock()
    if now - promptCache.at < 2 then return promptCache.list end
    local list = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then list[#list + 1] = d end
    end
    promptCache.at, promptCache.list = now, list
    S.prompts = #list
    return list
end

-- Ближайшие первыми, отсечка по радиусу.
local function inRange(list, origin, range)
    local out = {}
    for _, t in ipairs(list) do
        local d = (t.part.Position - origin).Magnitude
        if d <= range then out[#out + 1] = { t = t, dist = d } end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function nearest(list, origin)
    local best, bestDist = nil, math.huge
    for _, t in ipairs(list) do
        local d = (t.part.Position - origin).Magnitude
        if d < bestDist then best, bestDist = t, d end
    end
    return best, bestDist
end

