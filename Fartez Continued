-- KEY VAULT ------------------------------------------------------------
local function featureKeyVault()
    local zone = nil
    if F.AutoKeyVaultZone1 then zone = "StealZone1"
    elseif F.AutoKeyVaultZone2 then zone = "StealZone2"
    elseif F.AutoKeyVaultZone3 then zone = "StealZone3" end
    if not zone then return end

    local _, hum, hrp = refreshChar()
    if not hrp then return end

    local world = workspace:FindFirstChild("World")
    local zones = world and world:FindFirstChild("Zones")
    local zp = zones and zones:FindFirstChild(zone)
    if not zp then return end

    -- обычные яйца + вольт: в зоне могут лежать и те, и другие
    local targets, seen = {}, {}
    for _, e in ipairs(refreshEggs()) do
        if not seen[e.obj] and (e.part.Position - zp.Position).Magnitude <= 100 then
            seen[e.obj] = true
            targets[#targets + 1] = e
        end
    end
    for _, e in ipairs(refreshVaultEggs()) do
        if not seen[e.obj] and (e.part.Position - zp.Position).Magnitude <= 100 then
            seen[e.obj] = true
            targets[#targets + 1] = e
        end
    end

    local near, dist = nearest(targets, hrp.Position)
    if near then
        if dist > 10 then
            hum:MoveTo(near.part.Position)
            if hrp.AssemblyLinearVelocity.Magnitude < 1 and dist > 15 then hum.Jump = true end
        else
            hum:MoveTo(hrp.Position)
            local sent = {}
            for _, t in ipairs(targets) do
                if not sent[t.name] then
                    sent[t.name] = true
                    hitRemote("EggSpawnerService", EGG_REMOTES, t.name, t.obj)
                    hitRemote("EggVaultService", VAULT_REMOTES, t.name, t.obj)
                end
            end
        end
    else
        local d = (hrp.Position - zp.Position).Magnitude
        if d > 15 then
            hum:MoveTo(zp.Position)
            if hrp.AssemblyLinearVelocity.Magnitude < 1 and d > 20 then hum.Jump = true end
        else
            hum:MoveTo(hrp.Position)
        end
    end
end

