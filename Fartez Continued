local function partOf(d)
    if d:IsA("BasePart") then return d end
    return d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
end

-- Папки, где игра держит яйца и вольт. Раньше обе фичи читали один и
-- тот же список "Eggs/EggRenderModels", поэтому вольт либо не находил
-- свои модели, либо долбил обычные яйца чужим ремоутом. Теперь у
-- вольта свой набор контейнеров и свой кэш.
local EGG_CONTAINERS = { "Eggs", "EggRenderModels", "EggRenders" }
local VAULT_CONTAINERS = {
    "EggVault", "EggVaultModels", "EggVaultRenders", "VaultEggs",
    "VaultEggModels", "BigEggs", "EggVaultEggs", "Vault",
}

local function containersOf(names)
    local out = {}
    for _, n in ipairs(names) do
        local f = workspace:FindFirstChild(n)
        if f then out[#out + 1] = f end
    end
    return out
end

local function eggFolders()
    return containersOf(EGG_CONTAINERS)
end

local function isEggObject(d)
    if not (d:IsA("Model") or d:IsA("BasePart")) then return false end
    local n = d.Name
    return #n == 36 and n:find("-", 1, true) ~= nil
end

local function scanContainers(folders)
    local list, loose = {}, {}
    for _, folder in ipairs(folders) do
        for _, d in ipairs(folder:GetDescendants()) do
            if d:IsA("Model") or d:IsA("BasePart") then
                local p = partOf(d)
                if p then
                    local entry = { obj = d, part = p, name = d.Name }
                    if isEggObject(d) then
                        list[#list + 1] = entry
                    else
                        loose[#loose + 1] = entry
                    end
                end
            end
        end
    end
    -- UUID-имена в приоритете; если игра называет яйца иначе —
    -- берём всё, что лежит в папках, вместо пустого списка.
    if #list == 0 then list = loose end
    return list
end

local eggCache = { at = -math.huge, list = {} }
local function refreshEggs()
    local now = os.clock()
    if now - eggCache.at < 0.35 then return eggCache.list end
    local list = scanContainers(containersOf(EGG_CONTAINERS))
    eggCache.at, eggCache.list = now, list
    return list
end

local vaultCache = { at = -math.huge, list = {} }
local function refreshVaultEggs()
    local now = os.clock()
    if now - vaultCache.at < 0.35 then return vaultCache.list end
    local list = scanContainers(containersOf(VAULT_CONTAINERS))
    -- отдельной папки может не быть — тогда вольт лежит в общих яйцах
    if #list == 0 then list = refreshEggs() end
    vaultCache.at, vaultCache.list = now, list
    return list
end

-- для кнопки диагностики: что реально нашлось в воркспейсе
local function containerDump()
    local L = {}
    local function group(title, names)
        L[#L + 1] = title
        for _, n in ipairs(names) do
            local f = workspace:FindFirstChild(n)
            if f then
                local cnt = 0
                for _, d in ipairs(f:GetDescendants()) do
                    if d:IsA("Model") or d:IsA("BasePart") then cnt += 1 end
                end
                L[#L + 1] = string.format("  %-16s %-10s objects=%d", n, f.ClassName, cnt)
            else
                L[#L + 1] = string.format("  %-16s —", n)
            end
        end
    end
    group("EGGS:", EGG_CONTAINERS)
    group("VAULT:", VAULT_CONTAINERS)
    L[#L + 1] = "cached: eggs=" .. #refreshEggs() .. "  vault=" .. #refreshVaultEggs()
    return table.concat(L, "\n")
end

