local T = {
    bg       = Color3.fromRGB(9, 10, 13),
    panel    = Color3.fromRGB(15, 17, 22),
    surface  = Color3.fromRGB(21, 24, 31),
    surface2 = Color3.fromRGB(27, 31, 40),
    line     = Color3.fromRGB(40, 46, 58),
    accent   = Color3.fromRGB(4, 203, 41),
    accent2  = Color3.fromRGB(0, 232, 168),
    text     = Color3.fromRGB(240, 244, 250),
    dim      = Color3.fromRGB(132, 142, 158),
    danger   = Color3.fromRGB(222, 62, 62),
}

local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    inst.Parent = parent
    return inst
end

local function corner(inst, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst, color, th)
    return new("UIStroke", {
        Color = color or T.line, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function pad(inst, t, r, b, l)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
    }, inst)
end

local function vlist(inst, gap)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    }, inst)
end

local function makeDraggable(frame, handle)
    local dragging, startInput, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startInput, startPos = true, input.Position, frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

