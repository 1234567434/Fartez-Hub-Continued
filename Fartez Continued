-- Key Vault (v1: 0.1s, args fixed)
task.spawn(function()
    local hitEggRF = nil
    local hitVaultRF = nil
    local lastHit = 0
    while task.wait(0.1) do
        local zone = nil
        if _G.AutoKeyVaultZone1 then zone = "StealZone1"
        elseif _G.AutoKeyVaultZone2 then zone = "StealZone2"
        elseif _G.AutoKeyVaultZone3 then zone = "StealZone3" end
        if zone and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
            pcall(function()
                if not hitEggRF then
                    hitEggRF = game:GetService("ReplicatedStorage").Packages.Knit.Services.EggSpawnerService.RF.RequestHitEgg
                end
                if not hitVaultRF then
                    hitVaultRF = game:GetService("ReplicatedStorage").Packages.Knit.Services.EggVaultService.RF.RequestHitVaultEgg
                end
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local hum = LocalPlayer.Character.Humanoid
                local w = workspace:FindFirstChild("World")
                local zones = w and w:FindFirstChild("Zones")
                local zp = zones and zones:FindFirstChild(zone)
                if not zp then return end
                local targets = {}
                local closestPart = nil; local closestDist = math.huge
                for _, c in ipairs({workspace:FindFirstChild("Eggs"), workspace:FindFirstChild("EggRenderModels")}) do
                    if c then
                        for _, d in pairs(c:GetDescendants()) do
                            if ((d:IsA("Model") or d:IsA("BasePart")) and d.Name:find("-") and (#d.Name == 36)) then
                                local part = (d:IsA("BasePart") and d) or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                                if part then
                                    if (part.Position - zp.Position).Magnitude <= 100 then
                                        table.insert(targets, d)
                                        local dist = (hrp.Position - part.Position).Magnitude
                                        if dist < closestDist then closestDist = dist; closestPart = part end
                                    end
                                end
                            end
                        end
                    end
                end
                if closestPart then
                    local dist = (hrp.Position - closestPart.Position).Magnitude
                    if dist > 10 then
                        hum:MoveTo(closestPart.Position)
                        if (hrp.Velocity.Magnitude < 1 and dist > 15) then hum.Jump = true end
                    else
                        hum:MoveTo(hrp.Position)
                        if #targets > 0 and (os.clock() - lastHit) >= 0.6 then
                            lastHit = os.clock()
                            for _, t in ipairs(targets) do
                                task.spawn(function()
                                    pcall(function()
                                        if hitEggRF then hitEggRF:InvokeServer({t.Name}) end
                                        if hitVaultRF then hitVaultRF:InvokeServer({t.Name}) end
                                    end)
                                end)
                            end
                        end
                    end
                else
                    local dist = (hrp.Position - zp.Position).Magnitude
                    if dist > 15 then
                        hum:MoveTo(zp.Position)
                        if (hrp.Velocity.Magnitude < 1 and dist > 20) then hum.Jump = true end
                    else
                        hum:MoveTo(hrp.Position)
                    end
                end
            end)
        end
    end
end)

