                if t:find("drop", 1, true) or g.Name:lower():find("drop", 1, true) then
                    return
                end
            end
        end
    end

    if type(fireproximityprompt) ~= "function" then return end
    for _, d in ipairs(refreshPrompts()) do
        local txt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
        local skip = false
        for _, kw in ipairs(IgnoreActions) do
            if txt:find(kw, 1, true) then skip = true; break end
        end
        if not skip and (txt:find("pick", 1, true) or txt:find("up", 1, true)) then
            local anc = d:FindFirstAncestorWhichIsA("BasePart")
            if anc and (anc.Position - hrp.Position).Magnitude <= CFG.ranges.pickup then
                pcall(fireproximityprompt, d)
            end
        end
    end
end

