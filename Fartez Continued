-- 19. ГЛАВНЫЙ ЦИКЛ
-----------------------------------------------------------------------
local heartbeat
local running = true
local fpsFrames, fpsTime = 0, 0
local uiTick = 0

heartbeat = RunService.Heartbeat:Connect(function(dt)
    if not running then return end

    fpsFrames += 1
    fpsTime += dt
    if fpsTime >= 0.5 then
        S.fps = math.floor(fpsFrames / fpsTime + 0.5)
        fpsFrames, fpsTime = 0, 0
    end

    for _, tk in ipairs(tasks) do
        tk.t += dt
        local interval = tk.interval()
        if tk.t >= interval then
            tk.t = 0
            local ok, err = pcall(tk.fn)
            if not ok then
                S.errors += 1
                S.lastError = tostring(err)
            end
        end
    end

    uiTick += dt
    if uiTick >= 0.25 then
        uiTick = 0
        local ping = 0
        pcall(function()
            ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        S.ping = ping

        if F.AutoHitTurkey then refreshTurkeys() end
        if F.TurkeyCollect then refreshTurkeyCoins() end
        if F.AutoBreak or F.AutoHitBigEgg or F.AutoHitHalloween
            or F.AutoKeyVaultZone1 or F.AutoKeyVaultZone2 or F.AutoKeyVaultZone3 then
            S.eggs = #refreshEggs()
            S.vault = #refreshVaultEggs()
        end
        if turkeyCountLabel then
            local origin = (cachedHrp and cachedHrp.Position) or Vector3.zero
            turkeyCountLabel.Text = "моделей: " .. S.turkeys .. "  ·  с id: " .. S.turkeyIds
                .. "  ·  монет: " .. S.turkeyCoins
                .. "  ·  в радиусе: "
                .. #inRange(turkeyCache.list, origin, CFG.ranges.turkey)
        end

        local up = os.time() - S.startedAt
        local mm = math.floor(up / 60)
        local ss = up % 60

        if infoLabels.fps then
            infoLabels.fps.Text = "FPS: " .. S.fps
            infoLabels.ping.Text = "PING: " .. S.ping .. " ms"
            infoLabels.hits.Text = "HITS: " .. S.hits
            infoLabels.inflight.Text = "INFLIGHT: " .. S.inflight .. " / " .. CFG.maxInflight
            infoLabels.targets.Text = "ЦЕЛИ: яйца " .. S.eggs .. " · вольт " .. (S.vault or 0)
                .. " · индейки " .. S.turkeys .. "/" .. S.turkeyIds
            infoLabels.errors.Text = "ОШИБКИ: " .. S.errors
                .. (S.lastError and ("  ·  " .. S.lastError:sub(1, 40)) or "")
            infoLabels.missing.Text = "НЕ НАЙДЕНО: " ..
                (#S.missing > 0 and table.concat(S.missing, ", "):sub(1, 44) or "—")
            infoLabels.uptime.Text = string.format("UPTIME: %d:%02d", mm, ss)
        end
    end
end)

