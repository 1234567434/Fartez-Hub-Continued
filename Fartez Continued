-- 4) Auto Key Vault (Zone 1/2/3)
task.spawn(function()
    local hitEggRF, hitVaultRF, lastHit = nil, nil, 0

    while task.wait(0.1) do
        local zoneName
        if _G.AutoKeyVaultZone1 then zoneName = "StealZone1"
        elseif _G.AutoKeyVaultZone2 then zoneName = "StealZone2"
        elseif _G.AutoKeyVaultZone3 then zoneName = "StealZone3"
        end
        if not zoneName then continue end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then continue end

        pcall(function()
            hitEggRF   = hitEggRF   or GetRemote("EggSpawnerService.RF.RequestHitEgg")
            hitVaultRF = hitVaultRF or GetRemote("EggVaultService.RF.RequestHitVaultEgg")

            local rootPart = char.HumanoidRootPart
            local humanoid = char.Humanoid
            local world    = workspace:FindFirstChild("World")
            local zones    = world and world:FindFirstChild("Zones")
            local zone     = zones and zones:FindFirstChild(zoneName)
            if not zone then return end

            local nearbyEggs, closestEgg, closestPart, closestDist = {}, nil, nil, math.huge

            for _, container in ipairs({workspace:FindFirstChild("Eggs"), workspace:FindFirstChild("EggRenderModels")}) do
                if not container then continue end
                for _, d in pairs(container:GetDescendants()) do
                    if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:find("-") and #d.Name == 36 then
                        local part = d:IsA("BasePart") and d or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if part and (part.Position - zone.Position).Magnitude <= 100 then
                            table.insert(nearbyEggs, d)
                            local pd = (rootPart.Position - part.Position).Magnitude
                            if pd < closestDist then
                                closestDist, closestEgg, closestPart = pd, d, part
                            end
                        end
                    end
                end
            end

            if closestEgg and closestPart then
                local dist = (rootPart.Position - closestPart.Position).Magnitude
                if dist > 10 then
                    humanoid:MoveTo(closestPart.Position)
                    if rootPart.Velocity.Magnitude < 1 and dist > 15 then humanoid.Jump = true end
                else
                    humanoid:MoveTo(rootPart.Position)
                    if #nearbyEggs > 0 and (os.clock() - lastHit) >= 0.6 then
                        lastHit = os.clock()
                        for _, egg in ipairs(nearbyEggs) do
                            task.spawn(function()
                                pcall(function()
                                    local args = {[1] = {[1] = egg.Name}}
                                    if hitEggRF   then hitEggRF:InvokeServer(unpack(args))   end
                                    if hitVaultRF then hitVaultRF:InvokeServer(unpack(args)) end
                                end)
                            end)
                        end
                    end
                end
            else
                local zd = (rootPart.Position - zone.Position).Magnitude
                if zd > 15 then
                    humanoid:MoveTo(zone.Position)
                    if rootPart.Velocity.Magnitude < 1 and zd > 20 then humanoid.Jump = true end
                else
                    humanoid:MoveTo(rootPart.Position)
                end
            end
        end)
    end
end)

