-- 5.4 ДРОП ИНДЕЙКИ — workspace.TurkeyDrops/TurkeyCoin
--   После смерти индейки игра кладёт в TurkeyDrops меш TurkeyCoin.
--   Монета подбирается прикосновением, поэтому главное — дойти.
--   ProximityPrompt/ClickDetector на монете добиваются отдельно, если
--   исполнитель умеет их дёргать.
-----------------------------------------------------------------------
local function turkeyDropFolders()
    local out = {}
    for _, n in ipairs(TURKEY_DROP_FOLDERS) do
        local f = workspace:FindFirstChild(n)
        if f then out[#out + 1] = f end
    end
    return out
end

local function isCoinName(n)
    local l = string.lower(n)
    if string.find(l, "turkeycoin", 1, true) then return true end
    return string.find(l, "turkey", 1, true) ~= nil
        and string.find(l, "coin", 1, true) ~= nil
end

local coinCache = { at = -math.huge, list = {} }
local function refreshTurkeyCoins()
    local now = os.clock()
    if now - coinCache.at < 0.3 then return coinCache.list end

    local list, seenPart, loose = {}, {}, {}

    local function push(part, obj)
        if not part or seenPart[part] then return end
        -- модель-обёртка и её меш — одна и та же монета
        local anc = part.Parent
        while anc and anc ~= workspace do
            if anc:IsA("BasePart") and seenPart[anc] then return end
            anc = anc.Parent
        end
        seenPart[part] = true
        list[#list + 1] = {
            obj = obj or part, part = part, name = (obj or part).Name,
        }
    end

    for _, folder in ipairs(turkeyDropFolders()) do
        local ok, kids = pcall(function() return folder:GetDescendants() end)
        if ok then
            for _, d in ipairs(kids) do
                if d:IsA("BasePart") then
                    if isCoinName(d.Name) then push(d, d) else loose[#loose + 1] = d end
                elseif d:IsA("Model") and isCoinName(d.Name) then
                    push(partOf(d), d)
                end
            end
        end
    end

    -- в TurkeyDrops лежат только дропы: если имена другие — берём всё
    if #list == 0 then
        for _, p in ipairs(loose) do push(p, p) end
    end

    coinCache.at, coinCache.list = now, list
    S.turkeyCoins = #list
    return list
end

-- Монета, к которой не смогли дойти/подобрать, уходит в карантин на 30 с,
-- иначе цикл навсегда залипает на недостижимом дропе. Ключи слабые —
-- собранная монета сама выпадает из таблицы.
local coinSkip = setmetatable({}, { __mode = "k" })

local function coinBlocked(part)
    local untilAt = coinSkip[part]
    if not untilAt then return false end
    if os.clock() >= untilAt then
        coinSkip[part] = nil
        return false
    end
    return true
end

local function nearestCoin(origin, maxDist)
    local best, bestDist = nil, maxDist or math.huge
    for _, c in ipairs(refreshTurkeyCoins()) do
        if c.part.Parent and not coinBlocked(c.part) then
            local d = (c.part.Position - origin).Magnitude
            if d < bestDist then best, bestDist = c, d end
        end
    end
    return best, bestDist
end

local promptAt = 0
local function firePromptsNear(part, radius)
    local fired = 0
    local now = os.clock()
    if now - promptAt < 0.4 then return fired end
    promptAt = now
    if type(fireproximityprompt) == "function" then
        for _, d in ipairs(refreshPrompts()) do
            local anc = d:FindFirstAncestorWhichIsA("BasePart")
            if anc and (anc.Position - part.Position).Magnitude <= radius then
                if pcall(fireproximityprompt, d) then fired += 1 end
            end
        end
    end
    if type(fireclickdetector) == "function" then
        local ok, kids = pcall(function() return part:GetDescendants() end)
        if ok then
            for _, cd in ipairs(kids) do
                if cd:IsA("ClickDetector") then
                    if pcall(fireclickdetector, cd) then fired += 1 end
                end
            end
        end
    end
    return fired
end

