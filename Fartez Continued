if type(readfile) == "function" and type(isfile) == "function" then
    pcall(function()
        if isfile("fartez_hub_v4.json") then
            local data = HttpService:JSONDecode(readfile("fartez_hub_v4.json"))
            if type(data) == "table" then
                if data.speed and CFG.hitWait[data.speed] then F.ScriptSpeed = data.speed end
                if type(data.ranges) == "table" then
                    for k, v in pairs(data.ranges) do
                        if type(v) == "number" then CFG.ranges[k] = v end
                    end
                end
                if type(data.maxTargets) == "number" then CFG.maxTargets = data.maxTargets end
                if type(data.turkeyTravel) == "boolean" then CFG.turkeyTravel = data.turkeyTravel; F.TurkeyTravel = data.turkeyTravel end
                if type(data.turkeyHitVault) == "boolean" then CFG.turkeyHitVault = data.turkeyHitVault; F.TurkeyHitVault = data.turkeyHitVault end
                if type(data.turkeyAll) == "boolean" then F.TurkeyAll = data.turkeyAll end
                if type(data.turkeyBrute) == "boolean" then F.TurkeyBrute = data.turkeyBrute end
                if type(data.turkeyBruteMax) == "number" then
                    F.TurkeyBruteMax = math.clamp(math.floor(data.turkeyBruteMax), 100, 1000)
                end
                if type(data.turkeyBatch) == "number" then
                    CFG.turkeyBatch = math.clamp(math.floor(data.turkeyBatch), 1, 60)
                end
                if type(data.turkeyCollect) == "boolean" then F.TurkeyCollect = data.turkeyCollect end
                if type(data.autoAntiAfk) == "boolean" then F.AutoAntiAfk = data.autoAntiAfk end
                if type(data.turkeyApproach) == "number" then
                    CFG.turkeyApproach = math.clamp(data.turkeyApproach, 4, 80)
                end
                if type(data.turkeyCoinStop) == "number" then
                    CFG.turkeyCoinStop = math.clamp(data.turkeyCoinStop, 2, 40)
                end
                if type(data.turkeyCoinWait) == "number" then
                    CFG.turkeyCoinWait = math.clamp(data.turkeyCoinWait, 3, 60)
                end
                if type(data.argShape) == "number" and data.version == "4.4" then
                    F.ArgShape = math.clamp(math.floor(data.argShape), 1, #ARG_SHAPES)
                end
                if type(data.eggAll) == "boolean" then F.EggAll = data.eggAll end
                if type(data.eggAllTargets) == "number" then
                    CFG.eggAllTargets = math.clamp(math.floor(data.eggAllTargets), 1, 80)
                end
                if type(data.autoCalibrate) == "boolean" then CFG.autoCalibrate = data.autoCalibrate end
            end
        end
    end)
