local function featurePickup()
    if not F.AutoPickUp then return end
    local _, _, hrp = refreshChar()
    if not hrp then return end

    -- если открыт дроп-инвентарь — не трогаем мир
    for _, g in ipairs(PlayerGui:GetDescendants()) do
