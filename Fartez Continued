local function TweenTeleport(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local rootPart  = char.HumanoidRootPart
    local humanoid  = char:FindFirstChild("Humanoid")
    local walkSpeed = (humanoid and humanoid.WalkSpeed) or 16
    if walkSpeed <= 0 then walkSpeed = 16 end

    local destination = targetCFrame * CFrame.new(0, 3, 0)
    local distance    = (rootPart.Position - destination.Position).Magnitude
    local duration    = distance / walkSpeed

    local tween = TweenService:Create(
        rootPart,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = destination}
    )
    rootPart.Anchored = true

    local steppedConn = RunService.Stepped:Connect(function()
        for _, d in pairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then
                d.CanCollide = false
            end
        end
    end)

    tween:Play()
    tween.Completed:Connect(function()
        if steppedConn then steppedConn:Disconnect() end
        for _, d in pairs(char:GetDescendants()) do
            if d:IsA("BasePart") then d.CanCollide = true end
        end
        rootPart.Anchored = false
    end)
end

