local REMOTE_CLASSES = {
    RemoteEvent = true,
    RemoteFunction = true,
    UnreliableRemoteEvent = true,
}

local rIndex    = { at = -math.huge, list = {} }
local rResolved = {}
local rWarned   = {}
local shapeLock = {}

-- формы аргумента для ремоутов, принимающих имя цели.
-- 7 и 8 шлют саму модель: у индеек имя у всех "Turkey", и сервер
-- может различать их только по ссылке на объект.
local ARG_SHAPES = {
    { id = 1, label = "name",       build = function(n) return n end },
    { id = 2, label = "{name}",     build = function(n) return { n } end },
    { id = 3, label = "{Name=n}",   build = function(n) return { Name = n } end },
    { id = 4, label = "{name=n}",   build = function(n) return { name = n } end },
    { id = 5, label = "{id=n}",     build = function(n) return { id = n } end },
    { id = 6, label = "{target=n}", build = function(n) return { target = n } end },
    { id = 7, label = "model",      build = function(n, o) return o or n end },
    { id = 8, label = "{model}",    build = function(n, o) return { o or n } end },
}

-- Миграция v4.3 -> v4.4. Старый конфиг (_G и JSON) мог держать форму #1
-- (голая строка). Сервер её не принимает — яйца, вольт, босс и зоны
-- молчали. Один раз переписываем на #2 ({name}) и помечаем версию.
if CFG.version ~= "4.4" then
    F.ArgShape = 2
    CFG.version = "4.4"
end
if type(F.ArgShape) ~= "number" then F.ArgShape = 2 end
F.ArgShape = math.clamp(math.floor(F.ArgShape), 1, #ARG_SHAPES)

local function buildIndex(force)
    local now = os.clock()
    if not force and now - rIndex.at < 4 then return rIndex.list end
    local list = {}
    local ok = pcall(function()
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if REMOTE_CLASSES[d.ClassName] then
                local full = d:GetFullName()
                list[#list + 1] = {
                    obj   = d,
                    name  = d.Name,
                    lname = string.lower(d.Name),
                    path  = full,
                    lpath = string.lower(full),
                    fn    = (d.ClassName == "RemoteFunction"),
                }
            end
        end
    end)
    if ok then rIndex.at, rIndex.list = now, list end
    return rIndex.list
end

local function scoreEntry(e, service, want)
    local s
    if e.lname == want then s = 100
    elseif string.find(e.lname, want, 1, true) then s = 60
    elseif string.find(want, e.lname, 1, true) then s = 40
    else return 0 end
    local svc = string.lower(service)
    if string.find(e.lpath, svc, 1, true) then s += 30 end
    if string.find(e.lpath, "knit", 1, true) then s += 12 end
    if string.find(e.lpath, ".rf.", 1, true) then s += 6 end
    return s
end

local function findRemote(service, names)
    local list = buildIndex()
    local best, bestScore = nil, 0
    for _, want in ipairs(names) do
        local w = string.lower(want)
        for _, e in ipairs(list) do
            local sc = scoreEntry(e, service, w)
            if sc > bestScore then best, bestScore = e, sc end
        end
    end
    if bestScore >= 40 then return best end
    return nil
end

-- Точный путь, который игра использует сейчас:
--   ReplicatedStorage.Packages.Knit.Services.<Service>.(RF|RE).<Remote>
-- Проверяется первым: если ремоут лежит там, никакой скоринг уже не
-- нужен и перепутать его с похожим именем невозможно.
local function canonicalRemote(service, name)
    local node = ReplicatedStorage
    for _, seg in ipairs({ "Packages", "Knit", "Services", service }) do
        node = node and node:FindFirstChild(seg)
        if not node then return nil end
    end
    for _, box in ipairs({ "RF", "RE" }) do
        local holder = node:FindFirstChild(box)
        local r = holder and holder:FindFirstChild(name)
        if r and REMOTE_CLASSES[r.ClassName] then
            local full = r:GetFullName()
            return {
                obj   = r,
                name  = r.Name,
                lname = string.lower(r.Name),
                path  = full,
                lpath = string.lower(full),
                fn    = (r.ClassName == "RemoteFunction"),
            }
        end
    end
    return nil
end

-- names — строка или массив кандидатов, в порядке приоритета
local function remote(service, names)
    if type(names) == "string" then names = { names } end
    local key = service .. "/" .. names[1]
    local hit = rResolved[key]
    if hit and hit.obj and hit.obj.Parent then return hit.obj, hit end

    for _, want in ipairs(names) do
        local exact = canonicalRemote(service, want)
        if exact then
            rResolved[key] = exact
            return exact.obj, exact
        end
    end

    local e = findRemote(service, names)
    if e then
        rResolved[key] = e
        return e.obj, e
    end
    if not rWarned[key] then
        rWarned[key] = true
        S.missing[#S.missing + 1] = key
        print("[FARTEZ] ремоут не найден: " .. key)
    end
    return nil, nil
end

-- единая точка выстрела: кап параллельных запросов, счёт, лог ошибок
local function fireArgs(e, args)
    if not e or not e.obj or not e.obj.Parent then return false end
    if S.inflight >= CFG.maxInflight then return false end
    S.inflight += 1
    S.hits += 1
    task.spawn(function()
        local ok, err
        if e.fn then
            ok, err = pcall(function()
                return e.obj:InvokeServer(table.unpack(args, 1, args.n))
            end)
        else
            ok, err = pcall(function()
                e.obj:FireServer(table.unpack(args, 1, args.n))
            end)
        end
        S.inflight -= 1
        if not ok then
            S.errors += 1
            S.lastError = tostring(err)
        end
    end)
    return true
end

local function shapeOf(e)
    local id = shapeLock[e.path] or F.ArgShape or 2
    for _, s in ipairs(ARG_SHAPES) do
        if s.id == id then return s end
    end
    return ARG_SHAPES[2]
end

-- объявлена ниже (секция 5.5): нужна здесь для авто-калибровки
local testShapes

local calibrating = {}
local calibTried  = {}

-- Авто-калибровка формы аргумента. Первый выстрел по незнакомому
-- ремоуту запускает в фоне перебор всех форм; победитель пишется в
-- shapeLock[e.path] и дальше используется молча. Так фича работает
-- даже если ручной слайдер сбит или _G сброшен новым инжектом.
-- calibTried не даёт долбить сервер перебором каждый цикл, если
-- ответа не было вовсе.
local function autoCalibrate(service, names, target, obj)
    if not CFG.autoCalibrate then return end
    if type(target) ~= "string" or target == "" then return end
    local _, e = remote(service, names)
    if not e or not e.obj or not e.obj.Parent then return end
    if shapeLock[e.path] or calibrating[e.path] or calibTried[e.path] then return end
    calibrating[e.path] = true
    calibTried[e.path] = true
    task.spawn(function()
        local ok, err = pcall(function()
            local L = {}
            local winner = testShapes(service, names, target, L, "AUTO", obj)
            for _, s in ipairs(L) do print("[FARTEZ CAL] " .. s) end
            S.calib = (S.calib or 0) + 1
            S.lastCalib = e.path .. " -> " .. (winner and ("#" .. winner.id) or "нет ответа")
        end)
        if not ok then
            S.lastCalib = "ошибка: " .. tostring(err)
            print("[FARTEZ CAL] ошибка: " .. tostring(err))
        end
        calibrating[e.path] = nil
    end)
end

-- вызов по имени цели (яйцо, индейка, босс); obj — сама модель, если есть
local function hitRemote(service, names, target, obj)
    local found, e = remote(service, names)
    if not found then return false end
    if not shapeLock[e.path] then autoCalibrate(service, names, target, obj) end
    return fireArgs(e, table.pack(shapeOf(e).build(target, obj)))
end

-- вызов с фиксированными аргументами (номер платформы, id яйца и т.п.)
local function invokeNum(service, names, ...)
    local obj, e = remote(service, names)
    if not obj then return false end
    return fireArgs(e, table.pack(...))
end

